# aarch64 (GB10) cross build on an x86 host: aarch64 host compiler + sm_121a device code.
# /sysroot holds the aarch64 pieces the target provides (CUDA 13.0 sbsa libs, libibverbs, RDMA headers).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER /usr/bin/aarch64-linux-gnu-gcc-13)
set(CMAKE_CXX_COMPILER /usr/bin/aarch64-linux-gnu-g++-13)
set(CMAKE_CUDA_COMPILER /usr/local/cuda/bin/nvcc)
set(CMAKE_CUDA_HOST_COMPILER /usr/bin/aarch64-linux-gnu-g++-13)
set(_cuda_target /sysroot/usr/local/cuda-13.0/targets/sbsa-linux)
set(CMAKE_CUDA_FLAGS "-I/usr/local/cuda/include -I/sysroot/usr/include --allow-unsupported-compiler -L${_cuda_target}/lib -L${_cuda_target}/lib/stubs -L/sysroot/usr/lib/aarch64-linux-gnu")
set(CMAKE_CXX_FLAGS "-I/usr/local/cuda/include -I/sysroot/usr/include")
set(CMAKE_EXE_LINKER_FLAGS "-L${_cuda_target}/lib -L${_cuda_target}/lib/stubs -L/sysroot/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,/sysroot/usr/lib/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH /usr/aarch64-linux-gnu /sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
